{
  "name": "@skycoin/integration-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"README.md\"",
    "check": "npm run typecheck && npm test && npm run format:check && npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
